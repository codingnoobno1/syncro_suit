# ==============================================================================
# AegisOps Environment Configuration
# ==============================================================================
# Execution mode: "simulation" (zero external dependencies) or "live" (real Azure + brokers)
AEGIS_MODE=simulation
AEGIS_LOG_LEVEL=INFO
AEGIS_ENV=dev
AEGIS_API_HOST=0.0.0.0
AEGIS_API_PORT=8080
AEGIS_MCP_PORT=8090
AEGIS_HMAC_SECRET=change-me-in-production-use-azure-keyvault

# Azure Target Configuration (used when AEGIS_MODE=live)
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=eastus2
AZURE_DEFAULT_RG_PREFIX=rg-aegis

# Tri-Broker Fabric (set AEGIS_BROKER_BACKEND=live in Docker Compose / K8s)
AEGIS_BROKER_BACKEND=memory
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=aegisops-control-plane
RABBITMQ_URL=amqp://aegis:aegis-dev-pass@localhost:5672/aegis
REDIS_URL=redis://localhost:6379/0

# Security Policy Gates
AEGIS_OPA_POLICY_DIR=policies/opa
AEGIS_MAX_CRITICAL_FINDINGS=0
AEGIS_MAX_HIGH_FINDINGS=5
AEGIS_PROTECTED_ENVS=prod,production,shared-core

# Kubernetes Launcher
KUBECONFIG=~/.kube/config
AEGIS_K8S_NAMESPACE=aegisops
