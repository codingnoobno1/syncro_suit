{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AegisEphemeralDestroyOnlyTaggedResources",
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances",
        "ec2:DeleteSecurityGroup",
        "ec2:DeleteSubnet",
        "ec2:DeleteVpc",
        "eks:DeleteCluster",
        "s3:DeleteBucket"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/aegis:ephemeral": "true",
          "aws:ResourceTag/aegis:managed": "true"
        }
      }
    },
    {
      "Sid": "ExplicitDenyProductionAndIamEscalation",
      "Effect": "Deny",
      "Action": [
        "iam:*",
        "organizations:*",
        "kms:ScheduleKeyDeletion"
      ],
      "Resource": "*"
    }
  ]
}
