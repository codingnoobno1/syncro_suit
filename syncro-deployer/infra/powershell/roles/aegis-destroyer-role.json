{
  "Name": "AegisOps Ephemeral Destroyer",
  "IsCustom": true,
  "Description": "Break-glass ephemeral environment teardown role. MUST be bound with Azure ABAC tag condition aegis:ephemeral=true and PIM <= 2h.",
  "Actions": [
    "Microsoft.Resources/subscriptions/resourceGroups/read",
    "Microsoft.Resources/subscriptions/resourceGroups/delete",
    "Microsoft.ContainerService/managedClusters/delete",
    "Microsoft.Network/virtualNetworks/delete",
    "Microsoft.Network/networkSecurityGroups/delete",
    "Microsoft.Compute/disks/delete",
    "Microsoft.Network/networkInterfaces/delete",
    "Microsoft.ContainerRegistry/registries/delete"
  ],
  "NotActions": [
    "Microsoft.Authorization/locks/delete",
    "Microsoft.KeyVault/vaults/purge/action"
  ],
  "DataActions": [],
  "NotDataActions": [],
  "AssignableScopes": [
    "/subscriptions/${SUBSCRIPTION_ID}"
  ]
}
